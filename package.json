{
  "name": "syncup",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Safe Android phone photo/video backup and Google Takeout organizer",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && node ./tools/check-no-any.mjs",
    "gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin specta-gen",
    "specta:check": "npm run gen:bindings && git diff --exit-code -- src/lib/ipc.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "1.77.0",
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.6",
    "cn": "0.5.2",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
